# Native Aikya @@VERSION@@; no preinstalled Python, Node, npm or Git.
[CmdletBinding()]
param(
    [ValidateSet('global','project')][string]$Scope='global',
    [ValidateSet('stable','preview')][string]$Channel='@@CHANNEL@@',
    [string]$Version='@@VERSION@@',
    [string]$OfflineDir,
    [ValidateSet('install','uninstall')][string]$Action='install',
    [switch]$NoPath,
    [switch]$DryRun
)
$callerPreference=$ErrorActionPreference
try {
$ErrorActionPreference='Stop'
if ($Scope -ne 'global') { throw 'Native binaries use global scope; project memory stays local.' }
if ($Version -ne '@@VERSION@@' -or $Channel -ne '@@CHANNEL@@') { throw 'Use the installer belonging to the requested version and channel.' }
if ($DryRun) { @{action=$Action;version=$Version;channel=$Channel;writes=$false;network=$false} | ConvertTo-Json -Compress; return }
$arch=$env:PROCESSOR_ARCHITEW6432
if (-not $arch) { $arch=$env:PROCESSOR_ARCHITECTURE }
switch ($arch.ToUpperInvariant()) { 'AMD64' {$target='win32-x64'} 'ARM64' {$target='win32-arm64'} default {throw 'Unsupported native Windows architecture.'} }
$platforms=@{
@@PLATFORMS@@
}
if (-not $platforms.ContainsKey($target)) { throw 'This artifact set has no verified bundle for this platform.' }
$selected=$platforms[$target]
$stage=Join-Path ([IO.Path]::GetTempPath()) ('aikya-native-'+[guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $stage | Out-Null
try {
    $archive=Join-Path $stage 'terminal.zip'
    if ($OfflineDir) { Copy-Item -LiteralPath (Join-Path $OfflineDir $selected.asset) -Destination $archive }
    else {
        Add-Type -AssemblyName System.Net.Http
        $handler=New-Object Net.Http.HttpClientHandler; $handler.AllowAutoRedirect=$false
        $client=[Net.Http.HttpClient]::new($handler); $client.Timeout=[TimeSpan]::FromSeconds(300)
        try {
            $uri=[uri]('https://github.com/jlema0590/aikya-forge/releases/download/v@@VERSION@@/'+$selected.asset)
            for ($redirect=0; $redirect -le 5; $redirect++) {
                if ($uri.Scheme -ne 'https' -or $uri.UserInfo -or $uri.Host -notin @('github.com','release-assets.githubusercontent.com','objects.githubusercontent.com')) { throw 'Untrusted native release URL.' }
                $response=$client.GetAsync($uri,[Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
                if ([int]$response.StatusCode -ge 300 -and [int]$response.StatusCode -lt 400) {
                    $next=[uri]::new($uri,$response.Headers.Location); $response.Dispose(); $uri=$next; continue
                }
                try {
                    $response.EnsureSuccessStatusCode() | Out-Null
                    $input=$response.Content.ReadAsStreamAsync().GetAwaiter().GetResult(); $output=[IO.File]::Open($archive,[IO.FileMode]::CreateNew)
                    try {
                        $buffer=New-Object byte[] 65536; $total=0
                        while (($count=$input.Read($buffer,0,$buffer.Length)) -gt 0) {
                            $total+=$count; if ($total -gt 256000000) { throw 'Native archive exceeds its download bound.' }; $output.Write($buffer,0,$count)
                        }
                    } finally { $output.Dispose(); $input.Dispose() }
                } finally { $response.Dispose() }
                break
            }
            if (-not (Test-Path -LiteralPath $archive)) { throw 'Too many native download redirects.' }
        } finally { $client.Dispose(); $handler.Dispose() }
    }
    if ((Get-Item -LiteralPath $archive).Length -gt 256000000) { throw 'Native archive exceeds its download bound.' }
    $stream=[IO.File]::OpenRead($archive); $hasher=[Security.Cryptography.SHA256]::Create()
    try { $actual=[BitConverter]::ToString($hasher.ComputeHash($stream)).Replace('-','').ToLowerInvariant() } finally { $stream.Dispose(); $hasher.Dispose() }
    if ($actual -ne $selected.sha256) { throw 'Native bundle integrity checksum mismatch.' }
    $payload=Join-Path $stage 'payload'; Expand-Archive -LiteralPath $archive -DestinationPath $payload
    $python=Join-Path $payload $selected.python
    $options=@($Action,'--yes')
    if ($Action -eq 'install') { $options+=@('--payload',$payload,'--version',$Version,'--channel',$Channel); if ($NoPath) {$options+='--no-path'} }
    & $python -I -B -m aikya.installation.managed_cli @options
    if ($LASTEXITCODE -ne 0) { throw "Aikya native operation failed with exit $LASTEXITCODE" }
} finally { if (Test-Path -LiteralPath $stage) { Remove-Item -LiteralPath $stage -Recurse -Force } }
} finally { $ErrorActionPreference=$callerPreference }
